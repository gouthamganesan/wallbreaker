<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Only used when a sync outlives the share card and WorkManager has to
         promote it to a short foreground service to finish the upload. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Package visibility (Android 11+). Without this,
      getLaunchIntentForPackage("com.instapaper.android") returns null on any
      app with targetSdk >= 30 — the package is simply invisible to us — and
      "Open in Instapaper" silently degrades to opening instapaper.com in a
      browser. Declaring it is the only way to hand the user their actual app.
    -->
    <queries>
        <package android:name="com.instapaper.android" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@style/Theme.Wallbreaker">

        <!-- Config screen: what opens from the launcher icon -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Share target: translucent overlay. Label is what the share sheet shows. -->
        <activity
            android:name=".ShareActivity"
            android:label="@string/share_label"
            android:exported="true"
            android:theme="@style/Theme.Wallbreaker.Overlay"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- Raw HTML files: uploaded as full-text content via the Full API. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/html" />
                <data android:mimeType="application/xhtml+xml" />
            </intent-filter>
        </activity>

        <!-- WorkManager's own foreground service; it needs the dataSync type
             declared here to be allowed to run one on API 34+. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>
</manifest>
